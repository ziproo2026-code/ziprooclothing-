# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO TRANSACTIONAL EMAIL INTEGRATION (Official API Key)
# Secure server-side secret: Automatically read from process.env.BREVO_API_KEY
# (Also recognizes user secrets named 'ziproo', 'email', 'ziprooemail', or 'BREVO_API_KEY')
BREVO_API_KEY="YOUR_BREVO_API_KEY"
BREVO_SENDER_EMAIL="ziproo2026@gmail.com"
BREVO_SENDER_NAME="ZIPROO Atelier"

# ADMIN EMAIL NOTIFICATION (Receives real-time customer order alerts)
ADMIN_NOTIFICATION_EMAIL="ziprooclothing@gmail.com"

# SMTP EMAIL NOTIFICATION CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ziprooclothing@gmail.com"
SMTP_PASS="YOUR_APP_SPECIFIC_PASSWORD"
SMTP_FROM_NAME="ZIPROO Atelier Orders"

# TXTBEE / TEXTBEE AUTOMATIC SMS GATEWAY INTEGRATION
# Secure server-side secret: Automatically read from process.env.TXT_BEE_API_KEY
# (Also recognizes user secrets named 'zipsms', 'ziproosmsa', 'TEXTBEE_API_KEY', or 'TXT_BEE_API_KEY')
TXT_BEE_API_KEY="YOUR_TXTBEE_API_KEY"
TEXTBEE_DEVICE_ID="" # Optional: Discovered automatically from your linked device

# MSG91 SMS GATEWAY INTEGRATION (DLT Approved Indian Template Fallback)
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="YOUR_MSG91_TEMPLATE_ID"
MSG91_SENDER_ID="ZIPROO"

# RAZORPAY PAYMENT GATEWAY INTEGRATION
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# OPTIONAL GENERIC SMS GATEWAY FALLBACK
SMS_GATEWAY_API_URL="https://api.fast2sms.com/v3/sms"
SMS_GATEWAY_API_KEY="YOUR_SMS_API_KEY"
